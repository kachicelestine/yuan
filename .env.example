# Copy to .env and fill in. Variables prefixed NEXT_PUBLIC_ are compiled into the
# browser bundle, so never put secrets in them.

# ── Brand ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=Lychee
# One Chinese character shown in the app's seal mark.
NEXT_PUBLIC_BRAND_SEAL=荔
NEXT_PUBLIC_BRAND_TAGLINE=Straight from the source
# Public origin, used for share links, metadata and payment callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string. Leave empty in development to use the embedded
# database in .data/pglite (created and seeded automatically).
# Example: postgres://postgres:password@localhost:5432/lychee
DATABASE_URL=

# ── Sign-in ──────────────────────────────────────────────────────────────────
# 32+ random characters (e.g. `openssl rand -base64 32`). Required for real payments.
AUTH_SECRET=
# Show sign-in codes on screen instead of emailing them. Never in production.
AUTH_DEV_CODES=false
# Resend (resend.com) for sign-in emails. Without them, codes print to the server log.
RESEND_API_KEY=
EMAIL_FROM=

# ── Payments (stablecoins) ───────────────────────────────────────────────────
# simulated: invoices confirm in development without a chain.
# onchain:   invoices are verified against the networks configured below.
PAYMENTS_MODE=simulated
# Treasury addresses that receive buyer payments, per network.
PAYMENTS_BASE_ADDRESS=
PAYMENTS_SOLANA_ADDRESS=
PAYMENTS_TRON_ADDRESS=
# Base network for USDC: base-sepolia (test USDC, no value) or base (real money).
PAYMENTS_BASE_CHAIN=base-sepolia
# JSON-RPC endpoint for that network.
PAYMENTS_BASE_RPC_URL=https://sepolia.base.org
# USDC on Solana: devnet (test USDC from faucet.circle.com) or mainnet, and an RPC.
PAYMENTS_SOLANA_CLUSTER=devnet
PAYMENTS_SOLANA_RPC_URL=https://api.devnet.solana.com
# USDT on Tron: nile (test USDT from nileex.io) or mainnet, read through TronGrid.
PAYMENTS_TRON_NETWORK=nile
PAYMENTS_TRON_API_KEY=
# In onchain mode, each rail with a treasury address above is offered at checkout.

# ── Videos and uploads ─────────────────────────────────────────────────────────
# local keeps uploads and encoded videos in MEDIA_DIR; r2 uses a Cloudflare R2 bucket
# (see deploy/env.production.example for its settings).
STORAGE=local
MEDIA_DIR=.data/media
# ffmpeg encodes uploads when it's installed; copy plays them as uploaded. Empty = auto.
VIDEO_ENCODER=
# Hold new uploads for a moderator. Empty = on in production, off in development.
CONTENT_PREMODERATION=

# ── Live video ─────────────────────────────────────────────────────────────────
# A MediaMTX server for live rooms. Empty = rooms show the cover photo instead of
# video, and the studio says video isn't set up. To run one locally (Docker):
#   docker run -d --name lychee-mtx -p 8888:8888 -p 8889:8889 -p 8189:8189/udp
#     -v "$PWD/deploy/mediamtx.yml:/mediamtx.yml:ro" -e MTX_WEBRTCADDITIONALHOSTS=127.0.0.1
#     -e MTX_AUTHHTTPADDRESS=http://host.docker.internal:3000/api/live/auth
#     bluenviron/mediamtx:1.21.2
# then set http://localhost:8889 and http://localhost:8888 below. (In development the
# auth route needs no token; in production it needs INTERNAL_TOKEN.)
LIVE_INGEST_URL=
LIVE_PLAYBACK_URL=

# ── Sellers and admins ─────────────────────────────────────────────────────────
# Identity and business documents (STORAGE=local). Never served publicly.
PRIVATE_DIR=.data/private
# Comma-separated emails that can open /admin (they sign in with that email).
ADMIN_EMAILS=

# Share of each sale kept when Protect releases it to the shop.
PLATFORM_COMMISSION=0.06
