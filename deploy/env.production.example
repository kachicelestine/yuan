# Production settings, copied to /opt/lychee/.env on the server (never committed).
# Generate secrets with:  openssl rand -base64 32

# ── Brand (compiled into the browser bundle at build time) ──────────────────────
NEXT_PUBLIC_BRAND_NAME=Lychee
NEXT_PUBLIC_BRAND_SEAL=荔
NEXT_PUBLIC_BRAND_TAGLINE=Straight from the source
NEXT_PUBLIC_SITE_URL=https://example.com

# ── Secrets ─────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
AUTH_SECRET=
INTERNAL_TOKEN=
# The same value for every build, or open pages break after a deploy.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Sign-in email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Lychee <hello@example.com>
AUTH_DEV_CODES=false

# ── Payments ────────────────────────────────────────────────────────────────────
# simulated is refused in production unless DEMO_DEPLOYMENT=true (a demo or staging site).
# Launch on test networks (test coins, no value at risk). For real money switch to:
#   PAYMENTS_BASE_CHAIN=base, PAYMENTS_BASE_RPC_URL=https://mainnet.base.org,
#   PAYMENTS_SOLANA_CLUSTER=mainnet (and a paid RPC), PAYMENTS_TRON_NETWORK=mainnet,
# with mainnet treasury addresses, after reading the licensing risks in ARCHITECTURE.md.
PAYMENTS_MODE=onchain
PAYMENTS_BASE_CHAIN=base-sepolia
PAYMENTS_BASE_RPC_URL=https://sepolia.base.org
PAYMENTS_BASE_ADDRESS=
# Optional rails: leave an address empty to not offer it.
PAYMENTS_SOLANA_CLUSTER=devnet
PAYMENTS_SOLANA_RPC_URL=https://api.devnet.solana.com
PAYMENTS_SOLANA_ADDRESS=
PAYMENTS_TRON_NETWORK=nile
PAYMENTS_TRON_API_KEY=
PAYMENTS_TRON_ADDRESS=
DEMO_DEPLOYMENT=false

# ── Runtime ─────────────────────────────────────────────────────────────────────
JOBS=inline
LOG_FORMAT=json

# ── Videos and uploads ──────────────────────────────────────────────────────────
# r2: uploads go straight from browsers to the bucket, served from MEDIA_PUBLIC_URL.
# local: kept on the server's disk (the media volume); fine for a demo.
STORAGE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lychee-media
MEDIA_PUBLIC_URL=https://media.example.com
# No public domain on this one: seller identity documents.
R2_PRIVATE_BUCKET=lychee-private
# New uploads wait for a moderator before they're public.
CONTENT_PREMODERATION=true
# Share of each sale kept when Protect releases it to the shop.
PLATFORM_COMMISSION=0.06
# Who can open /admin (seller reviews, video approvals, reports, disputes, payouts).
ADMIN_EMAILS=you@example.com
ENCODE_THREADS=1

# ── Live video (optional; deploy/README.md step 5) ───────────────────────────────
# Tunnel hostnames: whip.<domain> → http://media:8889, live.<domain> → http://media:8888.
LIVE_INGEST_URL=
LIVE_PLAYBACK_URL=
# The server's public IP: browsers send video straight to it on UDP 8189.
PUBLIC_IP=
# Set to "live" to run the media server.
COMPOSE_PROFILES=

# ── Cloudflare ──────────────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── Backups to R2 (rclone) ──────────────────────────────────────────────────────
BACKUP_BUCKET=lychee-backups
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
